COMPOSE_PROJECT_NAME=devengine

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# GitHub App
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-app.pem
DEFAULT_BASE_BRANCH=develop

# Storage
DATABASE_URL=postgresql+psycopg://devengine:devengine_change_me@postgres:5432/devengine
POSTGRES_DB=devengine
POSTGRES_USER=devengine
POSTGRES_PASSWORD=devengine_change_me
REDIS_URL=redis://redis:6379/0
ENABLE_REDIS=true

# Paths
BASE_WORKSPACE_DIR=/app/workspace
LOCAL_TIMEZONE=Europe/London

# ngrok
ENABLE_NGROK=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Agent defaults
MAX_CI_RETRIES=3
MAX_ACTIVE_RUNS_PER_REPO=1
